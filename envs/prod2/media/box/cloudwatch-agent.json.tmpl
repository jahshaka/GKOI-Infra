{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "metrics": {
    "namespace": "@@CW_NAMESPACE@@",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}"
    },
    "aggregation_dimensions": [["AutoScalingGroupName"], ["InstanceId"]],
    "metrics_collected": {
      "cpu": { "totalcpu": true, "measurement": ["usage_active", "usage_iowait", "usage_steal"] },
      "mem": { "measurement": ["mem_used_percent", "mem_available"] },
      "disk": { "resources": ["/"], "measurement": ["used_percent", "inodes_used"], "ignore_file_system_types": ["sysfs", "devtmpfs", "tmpfs", "overlay", "squashfs"] },
      "net": { "resources": ["*"], "measurement": ["bytes_sent", "bytes_recv"] },
      "netstat": { "measurement": ["tcp_established"] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/lib/docker/containers/*/*-json.log", "log_group_name": "@@CW_LOG_PREFIX@@/container", "log_stream_name": "{instance_id}", "retention_in_days": 30 },
          { "file_path": "/var/log/syslog", "log_group_name": "@@CW_LOG_PREFIX@@/syslog", "log_stream_name": "{instance_id}", "retention_in_days": 30 },
          { "file_path": "/var/log/gkoi-media-bootstrap.log", "log_group_name": "@@CW_LOG_PREFIX@@/bootstrap", "log_stream_name": "{instance_id}", "retention_in_days": 30 },
          { "file_path": "/var/log/letsencrypt/letsencrypt.log", "log_group_name": "@@CW_LOG_PREFIX@@/bootstrap", "log_stream_name": "{instance_id}-certbot", "retention_in_days": 30 }
        ]
      }
    }
  }
}
